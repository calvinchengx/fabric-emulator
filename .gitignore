# Runtime state — the emulator's store, created at the repo root on first run.
# Anchored with a leading slash: a bare `data/` matches a directory of that name
# at ANY depth, which silently swallowed website/src/data/ too. That one is
# ignored deliberately by website/.gitignore; anything else landing in a nested
# data/ should be visible rather than disappear.
/data/
*.log

# Node
node_modules/

# Local tooling
.claude/

.nwave/
# Note: portal/dist IS committed — go:embed needs it for `go build` to be
# self-sufficient. Rebuild with `pnpm --filter fabric-emulator-portal build`.

# GoReleaser build output
/dist/

# The assembled docs site: site/index.html at the root with website/dist under
# docs/, plus the manifests scripts/build_landing_data.py copies beside the
# landing page. Rebuilt by .github/workflows/docs-site.yml on every publish.
/_site/

# Playwright
test-results/
playwright-report/

# Coverage profiles (CI writes cover.out via -coverprofile; regenerated, not committed)
cover.out
*.cover
coverage.out
# pytest-cov's data file and its HTML/XML reports.
.coverage
.coverage.*
coverage.xml
htmlcov/
badges/
# Go coverage: binary counter dirs (unit + e2e) and the merged text profile.
covdata/
coverage-merged.out

# Local TDS/scratch probes (untracked developer scratch)
/tmpprobe/

# Python environments and build artifacts (managed by uv)
.venv/
python/**/build/
python/**/*.egg-info/

# Python bytecode
__pycache__/

# examples/ runtime output — never committed. profiles.yml in particular is
# generated per run and carries a live access token.
examples/**/profiles.yml
examples/**/state.json
examples/**/target/
examples/**/logs/
examples/**/dbt_packages/
examples/**/.user.yml
# The .pbip project 27_tmdl_pbip.py generates — runtime output, and it carries
# the gold rows inline.
examples/**/pbip/
# Build output of the shared fixture package, and the per-run gold summary the
# examples write for their cross-example comparison.
examples/**/*.egg-info/
examples/**/gold_summary.json
examples/*/silver_summary.json
# The advanced example writes its own pair, under different names — the
# rule above does not cover them, so an advanced run left the tree dirty.
examples/*/gold_star_summary.json
examples/*/star_silver_summary.json

# Per-run artefact: silver.py fetches the cert the emulator is actually
# presenting and writes it here for dbt (which owns its own HTTP client and
# only honours REQUESTS_CA_BUNDLE). It changes every time the stack restarts.
examples/*/silver_dbt/.emulator-ca.pem
examples/*/gold*/.emulator-ca.pem

# Built by e2e/pbix-desktop/build_fixture.py — a 2 MB binary nobody can diff.
e2e/pbix-desktop/model.pbix

# Pre-fetched Spark jars (scripts/fetch_spark_jars.sh); the list is jars.txt.
docker/spark-runtime/jars/*.jar

# Local working notes (not for the repo)
LOCAL_GAPS.md
la_e2e.env

# Compiled python bytecode. These were tracked once and embedded the
# committing machine's absolute paths in the repo.
__pycache__/
*.py[cod]

# Vitest coverage output (the badge step reads coverage-summary.json in place).
portal/coverage/

# Intermediate frames and video from the flow.gif recording (docs/demo/flow.py).
docs/demo/.capture/

# .NET build output from the e2e probes (they build in-container).
bin/
obj/

# The compiled binary, when someone builds into the repo root rather than a
# temp dir. A `git add -A` sweeps up 30 MB of Mach-O otherwise, and it is the
# kind of thing that lands unnoticed because nothing fails.
/fabric-emulator
/fabric-emulator.exe
