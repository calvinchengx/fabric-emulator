# Microsoft's real dbt-fabric adapter (1.11+) talks TDS via mssql-python, which
# bundles its own ODBC driver (mssql-python-odbc). That is a different stack
# from the system msodbcsql18 + pyodbc path the previous adapter used, and is
# the point of this witness: a third independent TDS client against the same
# FedAuth front (go-mssqldb and pyodbc remain covered elsewhere).
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/

# git: dbt debug's environment check probes `git --help`.
# libltdl7 + krb5: mssql-python's bundled driver (DDBC) will not load without them.
# https://github.com/microsoft/mssql-python#installation
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git ca-certificates libltdl7 libkrb5-3 libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY python/ ./python/
RUN uv sync --frozen --no-install-project --group dbt-fabric
ENV PATH="/app/.venv/bin:${PATH}"

WORKDIR /project
COPY e2e/dbt-fabric/project/ /project/
COPY e2e/dbt-fabric/runner.py /runner.py

CMD ["python3", "/runner.py"]
