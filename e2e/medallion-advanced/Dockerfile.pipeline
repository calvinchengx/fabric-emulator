# Runs examples/medallion-advanced-pyspark (three source systems) — the same scripts a reader runs by hand, unmodified.
# pandas + delta-rs write OneLake Delta, the Microsoft ODBC Driver 18 carries
# FedAuth TDS to the warehouse surface, and Microsoft's real dbt-fabric builds
# gold. One image runs every hop.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/

# Microsoft ODBC Driver 18 (msodbcsql18) from packages.microsoft.com.
# git: dbt's environment check probes `git --help`.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gnupg ca-certificates git \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc \
       | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
       > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc \
    && rm -rf /var/lib/apt/lists/*

# The shared fixture package must land as a SIBLING of the example, because the
# example pyproject declares it as `{ path = "../contoso-fixtures" }`. Copying
# only the example directory leaves that path dangling and `uv sync --frozen`
# cannot resolve it.
COPY examples/contoso-fixtures/ /contoso-fixtures/
COPY examples/contoso-fixtures-advanced/ /contoso-fixtures-advanced/

# The example owns its dependencies and its lockfile, so CI installs exactly
# what a reader gets — and the emulator's own dependency graph stays clean of
# pandas/dbt/pyodbc. Lock first for layer caching, then bring in the code.
WORKDIR /example
COPY examples/medallion-advanced-pyspark/pyproject.toml examples/medallion-advanced-pyspark/uv.lock ./
RUN uv sync --frozen
ENV PATH="/example/.venv/bin:${PATH}"

COPY examples/medallion-advanced-pyspark/ /example/

CMD ["python3", "pipeline.py"]
