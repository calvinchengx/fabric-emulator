# The pipeline client: pandas + delta-rs write OneLake Delta, the Microsoft
# ODBC Driver 18 carries FedAuth TDS to the warehouse surface, and Microsoft's
# real dbt-fabric builds gold. One image runs every hop of the tutorial.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/

# Microsoft ODBC Driver 18 (msodbcsql18) from packages.microsoft.com.
# git: dbt's environment check probes `git --help`.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gnupg ca-certificates git \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc \
       | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
       > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY python/ ./python/
RUN uv sync --frozen --no-install-project --group medallion
ENV PATH="/app/.venv/bin:${PATH}"

COPY e2e/medallion/pipeline/ /pipeline/
WORKDIR /pipeline

CMD ["python3", "/pipeline/driver.py"]
