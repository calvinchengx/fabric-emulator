<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>daxpump</AssemblyName>
    <RootNamespace>daxpump</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same ADOMD.NET the Desktop and XMLA probes already pin. amd64;
         on ARM Windows the guest runs this as x64 (Prism). AMO/TOM is
         the write half: Server.Execute of TMSL CreateOrReplace. -->
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient.NetCore.retail.amd64" Version="19.*" />
    <PackageReference Include="Microsoft.AnalysisServices.NetCore.retail.amd64" Version="19.*" />
  </ItemGroup>
</Project>
