# The pinned stack. docker compose reads this file automatically from the
# project directory, so `docker compose up -d` and every `docker compose run`
# resolve the SAME images without depending on what is exported in your shell.
#
# That is not a style preference. These services keep their store in memory, and
# `docker compose run` recreates any dependency whose resolved config has
# drifted — so a version that came from the environment in one step and from a
# default in the next silently replaced the emulator mid-pipeline, and the
# workspace created in step 1 was gone by step 4.
#
# Override deliberately for a local build:
#   FABRIC_EMULATOR_VERSION=dev docker compose up -d --force-recreate
#
# Verify what is actually running rather than what you asked for — a stale tag
# reports the right name and the wrong bytes:
#   docker inspect fab-driven-fabric-emulator-1 --format '{{.Image}}'
FABRIC_EMULATOR_VERSION=0.15.1
ENTRA_EMULATOR_VERSION=0.9.0

# Sail is LakeSail's Rust Spark-Connect server, and the agent is what the
# emulator drives to execute a notebook. Both are published by the emulator's
# own release workflow and tagged with its version, so they move in lockstep
# with FABRIC_EMULATOR_VERSION above.
SAIL_VERSION=0.15.1
SPARK_AGENT_VERSION=0.15.1
