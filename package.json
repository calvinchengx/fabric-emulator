{
  "name": "fabric-emulator-workspace",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "portal:build": "pnpm --filter fabric-emulator-portal build",
    "docs:dev": "pnpm --filter fabric-emulator-docs dev",
    "docs:build": "pnpm --filter fabric-emulator-docs build"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "^4.18.1",
      "dompurify@>=3.4.13 <3.4.16": "^3.4.16",
      "katex@<0.18.2": "^0.18.2",
      "postcss-selector-parser@<7.1.6": "^7.1.6"
    }
  }
}
