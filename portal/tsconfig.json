{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // Nothing in src/ is JavaScript any more. `allowJs` stays on only for the
    // vendored shadcn barrels' interop; `checkJs` stays off because those are
    // upstream's files, regenerated by `shadcn-svelte add`, and type errors we
    // "fixed" there would be overwritten by the next update.
    "allowJs": true,
    "checkJs": false,
    // On for the files that DO opt in. Without strictNullChecks the generated
    // interface would accept `ev.version.toFixed()` on an optional field, which
    // is most of the class of bug it exists to catch.
    "strict": true,
    // Nothing is emitted here: Vite compiles, `svelte-check` only reads.
    "noEmit": true,
    "skipLibCheck": true,
    // The globals the suite is written against: `describe`/`it`/`expect` without
    // imports, and jest-dom's matchers (`toBeInTheDocument`, `toHaveClass`),
    // which are added to `expect` at runtime by vitest-setup.ts and therefore
    // have to be declared here or every assertion is a type error.
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest"],
    "paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
