        <text class="lbl" x="795" y="122" text-anchor="middle">SQL Server</text>
        <text class="sub" x="795" y="141" text-anchor="middle">warehouse T-SQL over real TDS</text>

        <rect class="bx" x="660" y="176" width="270" height="58" rx="10"/>
        <text class="lbl" x="795" y="200" text-anchor="middle">Kusto (Microsoft's container)</text>
        <text class="sub" x="795" y="219" text-anchor="middle">KQL eventhouses · profile</text>

        <rect class="bx" x="660" y="254" width="270" height="58" rx="10"/>
        <text class="lbl" x="795" y="278" text-anchor="middle">Apache Kafka (KRaft)</text>
        <text class="sub" x="795" y="297" text-anchor="middle">Eventstream · profile</text>

