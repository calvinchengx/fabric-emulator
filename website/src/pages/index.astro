        <path class="ar" d="M296 120 V90" marker-end="url(#a)"/>
        <path class="ar" d="M386 176 H434" marker-end="url(#a)"/>
        <path class="ar" d="M386 160 H410 V49 H654" marker-end="url(#a)"/>
        <path class="ar" d="M386 176 H420 V127 H654" marker-end="url(#a)"/>
        <path class="ar" d="M386 192 H420 V205 H654" marker-end="url(#a)"/>
        <path class="ar" d="M386 208 H410 V283 H654" marker-end="url(#a)"/>
