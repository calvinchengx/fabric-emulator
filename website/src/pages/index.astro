---
// THE SITE ROOT. Starlight owns every other route; this static page wins over
// its catch-all, so `/fabric-emulator/` is a landing page and the docs
// overview it replaced now lives at `/fabric-emulator/overview/` (first in the
// sidebar). No published URL moved: the docs were already served flat from the
// base, and only the root page changed.
//
// EVERY NUMBER HERE IS IMPORTED, NOT TYPED. site-stats.json is written by
// sync-docs.mjs from docs/parity.md and docs/witnesses.json on each build. The
// page this replaced hardcoded "113 supported capability claims" and was wrong
// by seven within a fortnight; a number in prose has no idea a row was added.
import stats from '../data/site-stats.json';

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/calvinchengx/fabric-emulator';
const p = stats.parity;
const w = stats.witnesses ?? {};
// A release build stamps `v0.33.0`; between releases it is `latest-<sha>`.
//
// TWO DIFFERENT FACTS, and the pill used to collapse them. `version` describes
// THIS BUILD; `latestRelease` describes the PROJECT. When the docs are built
// from main -- which is almost always, because they publish on push -- the
// first is `latest-<sha>` and the pill read `unreleased`. To anyone landing on
// the front page that says "nobody has cut a release of this", of a repository
// with a long tag history. The build being unreleased and the project being
// unreleased are not the same claim.
//
// So the pill leads with the release when there is one, and says plainly that
// the docs run ahead of it. Only a project with no tags at all says nothing.
const released = /^v\d+\.\d+\.\d+$/.test(stats.version);
const latestRelease = stats.latestRelease ?? null;
const onLatest = released && stats.version === latestRelease;
const pillVersion = released ? stats.version : latestRelease;
const releaseUrl = pillVersion ? `${repo}/releases/tag/${pillVersion}` : `${repo}/releases`;
// What the trailing clause says, in order of what the reader most needs:
//   on the tag        -> what you get
//   ahead of the tag  -> the release, and that these docs are newer
//   no tags at all    -> the honest "unreleased"
const pillNote = onLatest || released
  ? 'one binary, one compose file'
  : latestRelease
    ? `latest release \u00b7 docs built from ${stats.version}`
    : `building on ${stats.version}`;
const num = (n) => (typeof n === 'number' ? n.toLocaleString('en') : '—');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fabric Emulator — run Fabric work on a laptop</title>
<meta name="description" content="A local Microsoft Fabric: control plane, OneLake, Spark, T-SQL, pipelines, Eventstream and KQL, validating real Entra tokens. Every supported claim names the test that witnesses it.">
<link rel="canonical" href={`https://calvinchengx.github.io${base}`}>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>◫</text></svg>">
<style>
:root{
  --bg:#fbfbfa; --panel:#fff; --ink:#16181d; --muted:#5c6270; --line:#e3e5e9;
  --accent:#1a5fb4; --accent-soft:#e8f0fb;
  --ship:#0f6f4c; --ship-bg:#e6f3ed;
  --wip:#8a5a00; --wip-bg:#fdf3e0;
  --plan:#5c6270; --plan-bg:#eef0f3;
  --code:#f4f5f7; --diagram-line:#828c9c; --diagram-fill:#fff;
  --radius:14px;
  --font:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){
  :root{
    --bg:#0f1115; --panel:#151920; --ink:#e8eaee; --muted:#98a0ae; --line:#262b34;
    --accent:#77aaff; --accent-soft:#14202f;
    --ship:#5ec9a0; --ship-bg:#11291f;
    --wip:#e0a94a; --wip-bg:#2a2114;
    --plan:#98a0ae; --plan-bg:#1c212a;
    --code:#11151b; --diagram-line:#5a6575; --diagram-fill:#1c222c;
  }
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);
  line-height:1.65;-webkit-font-smoothing:antialiased}
.wrap{max-width:1000px;margin:0 auto;padding:0 24px}
a{color:var(--accent)}
code{font-family:var(--mono);font-size:.9em;background:var(--code);padding:.15em .4em;border-radius:5px}
pre{background:var(--code);border:1px solid var(--line);border-radius:var(--radius);
  padding:18px 20px;overflow-x:auto;font-family:var(--mono);font-size:.88rem;line-height:1.55}
pre code{background:none;padding:0}
h1,h2,h3{line-height:1.25;letter-spacing:-.02em}
h2{font-size:1.7rem;margin:0 0 8px}
.sec{padding:60px 0;border-top:1px solid var(--line)}
.sec>.wrap>p.lede{color:var(--muted);font-size:1.05rem;max-width:70ch;margin:0 0 32px}

.hero{padding:76px 0 64px}
.eyebrow{font-family:var(--mono);font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;
  color:var(--accent);margin:0 0 18px}
.hero h1{font-size:clamp(2.1rem,5.2vw,3.4rem);margin:0 0 20px;max-width:20ch}
.hero p{font-size:1.15rem;color:var(--muted);max-width:64ch;margin:0 0 14px}
.hero .claim{color:var(--ink);font-weight:600;border-left:3px solid var(--accent);
  padding-left:16px;margin-top:28px;max-width:62ch}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
.btn{display:inline-block;padding:11px 20px;border-radius:10px;text-decoration:none;
  font-weight:600;font-size:.94rem;border:1px solid var(--line)}
.btn.primary{background:var(--accent);color:var(--bg);border-color:var(--accent)}
.btn.ghost{color:var(--ink)}
.release-pill{display:inline-flex;align-items:center;gap:9px;margin:0 0 20px;padding:6px 14px;
  border:1px solid var(--line);border-radius:999px;background:var(--panel);
  text-decoration:none;color:var(--muted);font-size:.86rem}
.release-pill span{background:var(--accent-soft);color:var(--accent);font-weight:700;
  border-radius:999px;padding:2px 9px;font-size:.78rem}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;
  background:var(--line);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;margin-top:44px}
.stat{background:var(--panel);padding:20px}
.stat b{display:block;font-size:1.65rem;letter-spacing:-.03em}
.stat span{color:var(--muted);font-size:.83rem}

.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:24px}
.card h3{font-size:1.08rem;margin:0 0 10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.card p{margin:0 0 12px;color:var(--muted);font-size:.94rem}
.card .ev{font-family:var(--mono);font-size:.78rem;color:var(--ink);background:var(--code);
  border-radius:8px;padding:9px 12px;display:block}
.tag{font-size:.68rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;
  padding:3px 9px;border-radius:999px;white-space:nowrap}
.t-ship{color:var(--ship);background:var(--ship-bg)}
.t-wip{color:var(--wip);background:var(--wip-bg)}
.t-plan{color:var(--plan);background:var(--plan-bg)}

.tbl{width:100%;border-collapse:collapse;font-size:.92rem;margin-top:8px}
.tbl th,.tbl td{text-align:left;padding:11px 14px;border-bottom:1px solid var(--line);vertical-align:top}
.tbl th{font-size:.75rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:600}
.tbl td:first-child{font-weight:600}
.scroll{overflow-x:auto}

figure{margin:0}
figcaption{color:var(--muted);font-size:.85rem;margin-top:12px;text-align:center}
svg .lbl{font:600 12px var(--font);fill:var(--ink)}
svg .sub{font:11px var(--mono);fill:var(--muted)}
svg .bx{fill:var(--diagram-fill);stroke:var(--diagram-line);stroke-width:1.5}
svg .ac{fill:var(--accent-soft);stroke:var(--accent);stroke-width:1.5}
svg .ar{stroke:var(--diagram-line);stroke-width:1.5;fill:none}

.note{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--accent);
  border-radius:0 var(--radius) var(--radius) 0;padding:20px 24px;margin-top:28px}
.note b{display:block;margin-bottom:6px}
.note p{margin:0;color:var(--muted);font-size:.94rem}
.warn{border-left-color:var(--wip)}
footer{padding:44px 0 60px;border-top:1px solid var(--line);color:var(--muted);font-size:.88rem}
footer a{text-decoration:none}

.topnav{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);
  backdrop-filter:saturate(1.4) blur(8px);border-bottom:1px solid var(--line)}
.topnav .wrap{display:flex;align-items:center;gap:18px;height:56px}
.topnav .brand{font-family:var(--mono);font-size:.82rem;letter-spacing:.04em;
  text-transform:uppercase;color:var(--ink);text-decoration:none;font-weight:600}
.topnav .links{margin-left:auto;display:flex;gap:18px;align-items:center;flex-wrap:wrap}
.topnav .links a{color:var(--muted);text-decoration:none;font-size:.92rem}
.topnav .links a:hover{color:var(--accent)}
.topnav .links a.strong{color:var(--accent);font-weight:600}
@media (max-width:640px){.topnav .links a:not(.strong){display:none}}
</style>
</head>
<body>

<nav class="topnav">
  <div class="wrap">
    <a class="brand" href={base}>Fabric Emulator</a>
    <div class="links">
      <a href="#gap">Why</a>
      <a href="#runs">What it runs</a>
      <a href="#checked">Evidence</a>
      <a href="#start">Run it</a>
      <a href={repo}>GitHub</a>
      <a class="strong" href={`${base}01-quickstart/`}>Documentation &rarr;</a>
    </div>
  </div>
</nav>

<header class="hero">
  <div class="wrap">
    <p class="eyebrow">Fabric Emulator</p>
    <a class="release-pill" href={releaseUrl}>
      <span>{pillVersion ?? 'unreleased'}</span>
      {pillNote} &rarr;
    </a>
    <h1>Run your Fabric work on a laptop. Then prove it behaves.</h1>
    <p>A local <b>Microsoft Fabric</b>: the control plane, OneLake, and engines that genuinely
      run your code. Workspaces, items and their CI/CD definitions, workspace RBAC, git
      integration, jobs and the 202/poll long-running-operation contract, validating Microsoft
      Entra bearer tokens against <a href="https://calvinchengx.github.io/entra-emulator/">entra-emulator</a>{' '}
      exactly as real Fabric validates against Entra.</p>
    <p>Microsoft's own tools drive it: <code>fabric-cicd</code>, the Fabric CLI,{' '}
      <code>dbt-fabric</code>, the Terraform provider, the VS Code extension. The same pipeline
      runs unmodified here and against a real tenant.</p>
    <p class="claim">Every supported capability names the test that witnesses it, and CI fails
      when one loses its witness. Where something is a contract and not an engine, this page
      says which.</p>
    <div class="cta">
      <a class="btn primary" href={`${base}01-quickstart/`}>Quickstart</a>
      <a class="btn ghost" href={`${base}01-quickstart/`}>Read the docs</a>
      <a class="btn ghost" href={repo}>Source on GitHub</a>
      <a class="btn ghost" href={`${base}parity/`}>The parity map</a>
    </div>
    {/* stats:start — every figure below must be an expression, never a typed
        number. scripts/build_landing_data.py enforces it and fails the build
        if a literal appears, because this page's docs once said "113 supported
        capability claims" long after the figure was 120. */}
    <div class="stats">
      <div class="stat"><b>{num(p.real)}</b><span>capabilities graded real, of {num(p.total)}</span></div>
      <div class="stat"><b>{num(w.total)}</b><span>witnesses over {num(w.claims)} claims</span></div>
      <div class="stat"><b>{num(w.jobs)}</b><span>CI jobs driving real clients</span></div>
      <div class="stat"><b>{num(stats.e2e)}</b><span>end-to-end suites</span></div>
      <div class="stat"><b>{num(stats.docs)}</b><span>pages of documentation</span></div>
    </div>
    {/* stats:end */}
  </div>
</header>

<section class="sec" id="gap">
  <div class="wrap">
    <h2>The gap this is built around</h2>
    <p class="lede">Testing Fabric work against Fabric means a tenant, a capacity and a cloud
      round trip for every iteration. The consequences are specific, and they are not really
      about speed.</p>
    <div class="grid">
      <div class="card">
        <h3>A pull request cannot have a capacity</h3>
        <p>A capacity is shared and always on. Nothing spins one up per branch, so the Fabric
          part of a change is the part continuous integration never exercises.</p>
        <span class="ev">Here: `docker compose up`, per run, on the runner</span>
      </div>
      <div class="card">
        <h3>A workspace is shared state</h3>
        <p>One run's cleanup is another run's broken fixture. Teams either serialise on a
          workspace or discover the collision as a failure in somebody else's job.</p>
        <span class="ev">Here: a tenant per test, created and thrown away</span>
      </div>
      <div class="card">
        <h3>So the risky parts go untested</h3>
        <p>The deployment pipeline, the OneLake writes, the notebook that only fails on real
          data. They break in production because production was the first place they ran.</p>
        <span class="ev">Here: the same code, offline, before it is pushed</span>
      </div>
    </div>
    <div class="note">
      <b>An emulator cannot assert that it behaves like Fabric.</b>
      <p>That is the whole difficulty, and it is why this project spends more effort on evidence
        than on features. Real clients drive the surfaces, the differences that remain are{' '}
        <a href={`${base}37-runtime-fidelity-gaps/`}>written down</a> rather than left to be
        discovered, and the same suite can be pointed at a real tenant with{' '}
        <code>FABRIC_TARGET</code> to find out where the two disagree.</p>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <h2>How it fits together</h2>
    <p class="lede">One Go binary is the control plane and OneLake. The engines beside it are
      real, unmodified software: Sail for Spark, SQL Server for T-SQL, Microsoft's own Kusto
      container for KQL, Apache Kafka for Eventstream. No client knows it is not Fabric.{' '}
      <a href={`${base}03-architecture/`}>Architecture</a> takes the same picture apart — the
      emulator family, how a token is accepted, and the long-running-operation engine — and{' '}
      <a href={`${base}14-real-compute/`}>real compute</a> separates what genuinely executes from
      what is still only a contract.</p>
    <figure>
      <svg viewBox="0 0 940 380" width="100%" role="img" aria-label="Architecture: Microsoft's own clients authenticate against entra-emulator, then call the fabric-emulator binary, which serves the control plane, OneLake and the Livy and TDS front doors, and dispatches work to Sail, SQL Server, Kusto and Kafka.">
        <rect class="bx" x="8" y="120" width="150" height="112" rx="10"/>
        <text class="lbl" x="83" y="146" text-anchor="middle">Microsoft's tools</text>
        <text class="sub" x="83" y="167" text-anchor="middle">fabric-cicd · fab CLI</text>
        <text class="sub" x="83" y="183" text-anchor="middle">dbt · Terraform</text>
        <text class="sub" x="83" y="199" text-anchor="middle">VS Code · azcopy</text>
        <text class="sub" x="83" y="215" text-anchor="middle">your own pipeline</text>

        <rect class="bx" x="206" y="20" width="150" height="64" rx="10"/>
        <text class="lbl" x="281" y="46" text-anchor="middle">entra-emulator</text>
        <text class="sub" x="281" y="65" text-anchor="middle">real signed JWTs</text>

        <rect class="ac" x="206" y="120" width="180" height="112" rx="10"/>
        <text class="lbl" x="296" y="147" text-anchor="middle">fabric-emulator</text>
        <text class="sub" x="296" y="168" text-anchor="middle">control plane · RBAC</text>
        <text class="sub" x="296" y="184" text-anchor="middle">OneLake (ADLS · Blob)</text>
        <text class="sub" x="296" y="200" text-anchor="middle">Livy · TDS · pipelines</text>
        <text class="sub" x="296" y="216" text-anchor="middle">LRO engine · MCP</text>

        <rect class="bx" x="440" y="120" width="150" height="112" rx="10"/>
        <text class="lbl" x="515" y="150" text-anchor="middle">OneLake on disk</text>
        <text class="sub" x="515" y="171" text-anchor="middle">real Delta bytes</text>
        <text class="sub" x="515" y="187" text-anchor="middle">shortcuts</text>
        <text class="sub" x="515" y="203" text-anchor="middle">item-scoped security</text>

        <rect class="bx" x="660" y="20" width="270" height="58" rx="10"/>
        <text class="lbl" x="795" y="44" text-anchor="middle">Sail (Spark Connect, Rust)</text>
        <text class="sub" x="795" y="63" text-anchor="middle">notebooks · Livy · Delta write</text>

